{% extends 'base.html.twig' %}

{% block title %}Ajouter un chauffeur{% endblock %}

{% block body %}
<h1 class="dashboard-title">
    FleetManager - Ajouter un chauffeur
</h1>

<div class="card">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card-header">
                <h3>Ajouter un véhicule</h3>
            </div>

            <div class="card-body">

                {{ form_start(formView) }}

                <div class="row mb-3 align-items-center">
                    <div class="col-3">
                        {{ form_label(formView.lastname, 'Nom') }}
                    </div>
                    <div class="col-9">
                        {{ form_widget(formView.lastname) }}
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <div class="col-3">
                        {{ form_label(formView.firstname, 'Prénom') }}
                    </div>
                    <div class="col-9">
                        {{ form_widget(formView.firstname) }}
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <div class="col-3">
                        {{ form_label(formView.email, 'Email') }}
                    </div>
                    <div class="col-9">
                        {{ form_widget(formView.email) }}
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <div class="col-3">
                        {{ form_label(formView.phone, 'Numéro de téléphone') }}
                    </div>
                    <div class="col-9">
                        {{ form_widget(formView.phone) }}
                    </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        Enregistrer
                    </button>
                </div>

                {{ form_end(formView) }}

            </div>

        </div>
    </div>
</div>


{% endblock %}