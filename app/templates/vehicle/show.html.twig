{% extends 'base.html.twig' %}

{% block title %}
    Détail du véhicule
{% endblock %}

{% block body %}
    <h1 class="dashboard-title">
        FleetManager - Détail du véhicule
    </h1>


    <p class="P">
        <a href="{{ path('app_List_Vehicles') }}" class="btn btn-primary">
            Retour à la liste
        </a>
    </p>

    <div class="card">
        <h3>Information du véhicule</h3>

        <table class="table">
            <tr>
                <th>Marque</th>
                <td>{{ vehicle.brand }}</td>
            </tr>
            <tr>
                <th>Modèle</th>
                <td>{{ vehicle.model }}</td>
            </tr>
            <tr>
                <th>Immatriculation</th>
                <td>{{ vehicle.plateNumber }}</td>
            </tr>
            <tr>
                <th>Couleur</th>
                <td>{{ vehicle.color }}</td>
            </tr>
            <tr>
                <th>Carburant</th>
                <td>{{ vehicle.fuel }}</td>
            </tr>
            <tr>
                <th>Statut</th>
              <td>
        {% if vehicle.status == constant('App\\Entity\\Vehicle::STATUS_OUT_OF_SERVICE') %}
            Hors service
        {% elseif vehicle.activeAssignment %}
            En mission
        {% else %}
            Disponible
        {% endif %}
    </td>  
            </tr>
        </table>

        <div class="mb-3 d-flex justify-content-end gap-2">
            <a
                href="{{ path('app_vehicle_edit', {'id': vehicle.id}) }}"
                class="btn btn-primary"
            >
                Modifier
            </a>

       {% if activeAssignment %}

    <form method="post"
          action="{{ path('app_assignment_return', {'id': activeAssignment.id}) }}"
          onsubmit="return confirm('Terminer l\'affectation ?')"
          style="display:inline">

         <input type="hidden"
               name="_token"
               value="{{ csrf_token('return' ~ activeAssignment.id) }}">


        <button type="submit" class="btn btn-primary">
            Terminer l'affectation
        </button>

    </form>

{% endif %}
         
        {% if vehicle.status != 'Hors service' %}
         <a
        href="{{ path('app_vehicle_out_of_service', {'id': vehicle.id}) }}"
        class="btn btn-danger"
        >
        Mettre hors service
        </a>
       {% endif %}

        </div>
    </div>

    
{% if activeAssignment %}
    <div class="card mt-5">
        <h3>Information du chauffeur</h3>

        <table class="table">
            <tr>
                <th>Nom</th>
                <td>{{ activeAssignment.driver.lastname }}</td>
            </tr>
            <tr>
                <th>Prénom</th>
                <td>{{ activeAssignment.driver.firstname }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ activeAssignment.driver.email }}</td>
            </tr>
            <tr>
                <th>Téléphone</th>
                <td>{{ activeAssignment.driver.phone }}</td>
            </tr>
        </table>
    </div>
{% endif %}
    
{% endblock %}