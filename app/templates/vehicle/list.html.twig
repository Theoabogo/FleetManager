{% extends 'base.html.twig' %}

{% block title %}Liste des vehicules{% endblock %}

{% block body %}
<h1 class="dashboard-title">
    FleetManager - Liste des vehicules
</h1>
<p class="P">
    <a href="{{ path('app_vehicle_add_vehicle') }}" class="btn btn-primary">Ajouter un véhicule</a>
</p>

<div class="liste-vehicles">

    {% if filter != 'available' %}
    <a href="{{ path('app_List_Vehicles', {'status': 'available'}) }}" class="dashboard-card-link">
    <div class="card">
        <h3>Disponibles</h3>
        <p>{{ available }}</p>
    </div>
    </a>
    {% endif %}

    {% if filter != 'assigned' %}
    <a href="{{ path('app_List_Vehicles', {'status': 'assigned'}) }}" class="dashboard-card-link">
    <div class="card">
        <h3>Emprunts</h3>
        <p>{{ totalEmprunts }}</p>
    </div>
    </a>
    {% endif %}

    {% if filter != 'maintenance' %}
    <a href="{{ path('app_List_Vehicles', {'status': 'maintenance'}) }}" class="dashboard-card-link">
    <div class="card">
        <h3>Maintenance</h3>
        <p>{{ maintenance }}</p>
    </div>
    </a>
    {% endif %}

    {% if filter != 'out_of_service' %}
    <a href="{{ path('app_List_Vehicles', {'status': 'out_of_service'}) }}" class="dashboard-card-link">
    <div class="card">
        <h3>Hors service</h3>
        <p>{{ outOfService }}</p>
    </div>
    </a>
    {% endif %}

</div>
 

<div class="table-liste">
    <table class="table table-vehicule">
        <thead>
            <tr>
                <th>Marques</th>
                <th>Modèles</th>
                <th>Immatriculations</th>
                <th>Statuts</th>
                <th>Actions</th>
                

            </tr>
        </thead>
        <tbody>
            {% for vehicle in vehicles %}
                <tr>
    <td>{{ vehicle.brand }}</td>
    <td>{{ vehicle.model }}</td>
    <td>{{ vehicle.plateNumber }}</td>
  <td>
    {{ vehicle.getAssignementStatus }}
</td>
    <td>
        <a href="{{ path('app_vehicle_show', {'id': vehicle.id}) }}" class="btn btn-sm btn-outline-primary">Detail vehicule</a>
        
    </td>
</tr>
            {% endfor %}
        </tbody>
    </table>

   

{% endblock %}

